# Copy this file to .env and fill in real values. Never commit .env.
# Set at least one LLM key. Groq is recommended (much higher free quota).

# --- Groq Cloud: https://console.groq.com/keys  (preferred LLM provider) ---
GROQ_API_KEY=

# --- Google AI Studio: https://aistudio.google.com/apikey  (fallback) ---
GEMINI_API_KEY=

# --- Google Cloud Console: enable "YouTube Data API v3", then create a key.
#     Optional — without it, the YouTube embed degrades to a search link. ---
YOUTUBE_API_KEY=

# --- Spotify Developer dashboard: NOT used by default any more (Spotify
#     now requires the app owner to hold a Premium subscription). The
#     legacy SpotifyClient stays in the codebase for reference. ---
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
